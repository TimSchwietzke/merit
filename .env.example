# Copy to .env and fill in. Never commit .env — see CLAUDE.md, hard rule 1.
#
# Both values below are safe to expose in the browser — that is what the
# VITE_ prefix means: Vite inlines them into the client bundle. Access control
# comes from Row Level Security in Postgres, never from hiding the anon key.
#
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── NOT here ────────────────────────────────────────────────────────
# service_role key  — bypasses RLS. Never in the client, never in this file,
#                     never in the repo. Server-side contexts only.
# USDA api.data.gov — set as a secret on the Supabase Edge Function:
#                     supabase secrets set USDA_API_KEY=…
#                     A VITE_ prefixed key would ship to every browser, and
#                     data.gov deactivates keys it finds in public repos.
