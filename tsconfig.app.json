{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Paths — shadcn's CLI expects the @/* alias. Mirrored in vite.config.ts.
       No baseUrl: deprecated in TS 6, and paths resolve relative to this file. */
    "paths": { "@/*": ["./src/*"] },

    /* Linting — CLAUDE.md: strict mode, no `any`. */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* The USDA mapper runs inside an Edge Function but is plain TypeScript with
     no imports, so it is typechecked here with everything else. Its neighbour
     index.ts is Deno and is not. */
  "include": ["src", "supabase/functions/**/map.ts"]
}
